PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://avenqra_user:avenqra_password@localhost:5432/avenqra_db?schema=public"
JWT_SECRET="supersecret_jwt_key_avenqra_2026"
JWT_EXPIRES_IN="7d"
AI_SERVICE_URL="http://localhost:8000"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# --- AVENQRA additive config (optional; safe defaults) ---
# SLA enforcement window in minutes (server worker). Default 30.
SLA_MINUTES=30
# Assistant provider: rules (default, no key needed) | openai (needs AI_API_KEY)
AI_PROVIDER=rules
AI_MODEL=gpt-4o-mini
AI_API_KEY=""
AI_API_URL="https://api.openai.com/v1/chat/completions"
# Notifications: demo when true or when no provider configured. Never real-secret here.
NOTIFICATION_DEMO_MODE=true
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
SMS_PROVIDER_URL=""
CORPORATION_WEBHOOK_URL=""
CORPORATION_WEBHOOK_KEY=""
